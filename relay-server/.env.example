# Required
PULSE_API_KEY=change-me-to-a-random-secret

# Optional
PORT=9000
DB_PATH=./data/relay.db
COMMAND_TIMEOUT_MS=10000

# Optional - enables the automated crash-fix pipeline (GitHub repository_dispatch).
# Leave unset to run the relay with the pipeline disabled.
GITHUB_TOKEN=
GITHUB_REPO=owner/repo
DISPATCH_COOLDOWN_MS=3600000
